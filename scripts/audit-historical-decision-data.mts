import path from 'node:path';import {scanHistoricalMissionRoot} from '../src/decision-history-import.js';
const roots=[{source:'v3' as const,root:path.resolve('.agent-runtime/instances/v2-default/missions')},{source:'v2b' as const,root:path.resolve('../FS-Remote-MCP-V2B/.agent-runtime/instances/v2b/missions')},{source:'v2b' as const,root:path.resolve('../FS-Remote-MCP-V2B/.agent-runtime/instances/v2-default/missions')}];const all=[] as any[];let excluded=0;for(const r of roots){const x=await scanHistoricalMissionRoot(r.root,r.source);all.push(...x.records);excluded+=x.excluded}const unique=[...new Map(all.map(x=>[`${x.source}:${x.missionHash}:${x.stepHash}`,x])).values()];console.log(JSON.stringify({schemaVersion:'fs.decision.history-audit.v1',scannedRoots:roots.length,candidates:unique.length,positive:unique.filter(x=>x.positive).length,negative:unique.filter(x=>!x.positive).length,excluded,domains:Object.fromEntries([...new Set(unique.map(x=>x.experience.domain))].map(d=>[d,unique.filter(x=>x.experience.domain===d).length])),workShapes:Object.fromEntries([...new Set(unique.map(x=>x.experience.workShape))].map(d=>[d,unique.filter(x=>x.experience.workShape===d).length]))},null,2));
