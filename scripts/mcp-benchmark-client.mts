import {Client,StreamableHTTPClientTransport} from '@modelcontextprotocol/client';import fs from 'node:fs/promises';import path from 'node:path';import {performance} from 'node:perf_hooks';
const configPath=process.argv[2],profile=process.argv[3]??'v3-optimized',task=process.argv[4]??'inspect-context';if(!configPath)throw new Error('Usage: mcp-benchmark-client.mts <config.json> <profile> <task>');const raw=await fs.readFile(configPath,'utf8'),config=JSON.parse(raw.replace(/^\uFEFF/,'')),url=new URL(`/mcp/${config.endpointSecret}`,`http://${config.host}:${config.port}`),client=new Client({name:'fs-benchmark-client',version:'1'});await client.connect(new StreamableHTTPClientTransport(url));const calls:any[]=[];async function call(name:string,args:any){const t=performance.now(),r=await client.callTool({name,arguments:args}),wallMs=performance.now()-t,bytes=Buffer.byteLength(JSON.stringify(r),'utf8');calls.push({name,wallMs,bytes});return r}const root='fs',cwd=String(process.env.FS_BENCH_CWD??'.');if(task==='inspect-context'){if(profile==='v2b-current'){await call('inspect_repository',{root,cwd});await call('repository_map',{root,cwd,limit:120});await call('applicable_instructions',{root,cwd,target:'.'})}else await call('engineering_context',{root,cwd,fileLimit:120})}else if(task==='runtime-identity'){await call('runtime_identity',{})}else throw new Error('Direct MCP client supports inspect-context and runtime-identity; edit/failure/build require another benchmark client or reasoning harness.');console.log(JSON.stringify({profile,task,calls,totalWallMs:calls.reduce((n,x)=>n+x.wallMs,0),totalResponseBytes:calls.reduce((n,x)=>n+x.bytes,0)},null,2));await client.close();
