import {execFile} from 'node:child_process';import {promisify} from 'node:util';import os from 'node:os';import path from 'node:path';import {createBenchmarkFixture} from '../src/benchmark-fixture.js';const exec=promisify(execFile),root=path.join(os.tmpdir(),'fs-git-inspect-strategy');await createBenchmarkFixture(root);const commands=[['branch','--show-current'],['rev-parse','HEAD'],['status','--short','--branch'],['remote','-v'],['log','-5','--oneline']];async function one(args:string[]){const t=performance.now();await exec('git',args,{cwd:root,windowsHide:true,maxBuffer:2_000_000});return performance.now()-t}const rows:any[]=[];for(let i=0;i<20;i++){let t=performance.now();const concurrent=await Promise.all(commands.map(one)),concurrentWall=performance.now()-t;t=performance.now();const sequential=[];for(const c of commands)sequential.push(await one(c));const sequentialWall=performance.now()-t;rows.push({repeat:i,concurrentWall,concurrentMax:Math.max(...concurrent),sequentialWall,sequentialMax:Math.max(...sequential)})}const summarize=(key:string)=>{const xs=rows.map(x=>x[key]).sort((a,b)=>a-b);return{median:xs[Math.floor(xs.length/2)],max:Math.max(...xs),over1s:xs.filter(x=>x>=1000).length,over3s:xs.filter(x=>x>=3000).length}};console.log(JSON.stringify({concurrentWall:summarize('concurrentWall'),concurrentMax:summarize('concurrentMax'),sequentialWall:summarize('sequentialWall'),sequentialMax:summarize('sequentialMax'),rows},null,2));
