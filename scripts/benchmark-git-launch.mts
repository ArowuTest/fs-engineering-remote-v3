import {spawn} from 'node:child_process';import os from 'node:os';import path from 'node:path';import {createBenchmarkFixture} from '../src/benchmark-fixture.js';import {ProcessManager} from '../src/processes.js';
const root=path.join(os.tmpdir(),'fs-git-launch-micro');await createBenchmarkFixture(root);const manager=new ProcessManager({shell:process.platform==='win32'?'powershell.exe':'/bin/sh',maxOutputBytes:100000});
function directGit(){return new Promise<any>((resolve,reject)=>{const started=performance.now(),p=spawn('git',['branch','--show-current'],{cwd:root,windowsHide:true}),spawned=performance.now();let stdout='',stderr='';p.stdout.on('data',x=>stdout+=x);p.stderr.on('data',x=>stderr+=x);p.on('error',reject);p.on('close',code=>resolve({code,spawnLatencyMs:spawned-started,durationMs:performance.now()-started,stdout:stdout.trim(),stderr:stderr.trim()}))})}
const direct:any[]=[],shell:any[]=[];for(let i=0;i<30;i++){direct.push(await directGit());shell.push(await manager.run('git branch --show-current',root,10000))}const summarize=(xs:any[])=>{const values=xs.map(x=>x.durationMs).sort((a,b)=>a-b),median=values[Math.floor(values.length/2)];return{medianMs:median,maxMs:Math.max(...values),over1s:xs.filter(x=>x.durationMs>=1000).length,over3s:xs.filter(x=>x.durationMs>=3000).length,rows:xs.map(x=>({durationMs:x.durationMs,spawnLatencyMs:x.spawnLatencyMs,executionMs:x.executionMs??Math.max(0,x.durationMs-x.spawnLatencyMs)}))}};console.log(JSON.stringify({direct:summarize(direct),shell:summarize(shell)},null,2));
