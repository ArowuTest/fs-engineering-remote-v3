import fs from 'node:fs/promises';
const service=process.argv[2],required=(process.argv[3]??'').split(',').filter(Boolean);if(!service||!required.length)throw new Error('Usage: railway-variable-preflight.mts <service> <comma-separated-required-keys>');const raw=await new Promise<string>((resolve,reject)=>{let s='';process.stdin.setEncoding('utf8');process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>resolve(s));process.stdin.on('error',reject)}),vars=JSON.parse(raw||'{}'),keys=new Set(Object.keys(vars)),missing=required.filter(k=>!keys.has(k));if(missing.length)throw new Error(`${service} missing required Railway variables: ${missing.join(', ')}`);console.log(JSON.stringify({service,ok:true,requiredPresent:required.length,totalVariables:keys.size}));
