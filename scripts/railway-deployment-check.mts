const expected=process.argv[2];if(!expected)throw new Error('Usage: railway-deployment-check.mts <expected-revision>');const raw=await new Promise<string>((resolve,reject)=>{let s='';process.stdin.setEncoding('utf8');process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>resolve(s));process.stdin.on('error',reject)}),rows=JSON.parse(raw||'[]'),latest=rows[0];if(!latest)throw new Error('No Railway deployment found.');const meta=latest.meta??{},matches=meta.commitHash===expected||String(meta.cliMessage??'').includes(expected);if(latest.status!=='SUCCESS'||!matches)throw new Error(`Latest Railway deployment did not match expected revision ${expected}: ${JSON.stringify({id:latest.id,status:latest.status,commitHash:meta.commitHash,cliMessage:meta.cliMessage})}`);console.log(JSON.stringify({ok:true,id:latest.id,status:latest.status,revision:expected}));
