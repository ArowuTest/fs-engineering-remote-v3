import {spawn} from 'node:child_process';import path from 'node:path';
const python=process.env.FS_LAYA_PYTHON;if(!python)throw new Error('FS_LAYA_PYTHON required');const adapter=path.resolve('vendor/laya-upstream/fs_shadow_adapter.py');
const cases=[
 {name:'transient-retry',state:{operation:'build',attempt:1,maxAttempts:3,risk:'medium',destructive:false,localOnly:false,sensitive:false,worker:{localAvailable:true,sandboxAvailable:true,hostedAvailable:true},checks:{test:'fail'},evidence:{required:2,freshPassing:1,freshFailing:1,complete:false},failure:{class:'transient'},models:{freeAvailable:true,paidConsent:false,councilAvailable:true},repository:{dirty:false,changedFileCount:0,changedDomains:[]}},expected:{retry:true,executor:'sandbox',risk:'medium'}},
 {name:'source-no-retry',state:{operation:'test',attempt:1,maxAttempts:3,risk:'high',destructive:false,localOnly:true,sensitive:true,worker:{localAvailable:true,sandboxAvailable:true,hostedAvailable:true},checks:{test:'fail'},evidence:{required:1,freshPassing:0,freshFailing:1,complete:false},failure:{class:'source'},models:{freeAvailable:true,paidConsent:false,councilAvailable:true},repository:{dirty:true,changedFileCount:3,changedDomains:['source']}},expected:{retry:false,executor:'local',risk:'high'}},
 {name:'critical-destructive',state:{operation:'deploy',attempt:0,maxAttempts:1,risk:'critical',destructive:true,localOnly:false,sensitive:true,worker:{localAvailable:true,sandboxAvailable:false,hostedAvailable:true},checks:{test:'pass'},evidence:{required:2,freshPassing:2,freshFailing:0,complete:true},failure:{class:'none'},models:{freeAvailable:true,paidConsent:true,councilAvailable:true},repository:{dirty:false,changedFileCount:5,changedDomains:['deployment']}},expected:{retry:false,executor:'hosted',risk:'critical'}}
];
const questions=[{id:'retry',type:'noul',proposition:'Should this engineering operation be retried without changing source?'},{id:'executor',type:'choice',options:['local','sandbox','hosted'],instructions:'Choose the safest suitable execution lane.'},{id:'risk',type:'score',levels:['low','medium','high','critical'],instructions:'Estimate operational risk.'}];
async function run(c:any){return new Promise<any>((resolve,reject)=>{const started=performance.now(),p=spawn(python,[adapter],{env:{...process.env,FS_LAYA_DEVICE:'cpu'},stdio:['pipe','pipe','pipe']});let out='',err='';p.stdout.on('data',x=>out+=x);p.stderr.on('data',x=>err+=x);p.on('exit',code=>code?reject(new Error(err)):resolve({name:c.name,elapsedMs:Math.round(performance.now()-started),result:JSON.parse(out),stderr:err}));p.stdin.end(JSON.stringify({schemaVersion:'fs.decision.request.v1',state:{schemaVersion:'fs.decision.state.v1',...c.state},questions})+'\n')})}
for(const c of cases){const r=await run(c),a=Object.fromEntries(r.result.answers.map((x:any)=>[x.id,x]));console.log(JSON.stringify({case:c.name,elapsedMs:r.elapsedMs,predicted:{retry:a.retry.probabilityTrue>=.5,executor:a.executor.selected,risk:a.risk.selected},expected:c.expected,confidence:{retry:a.retry.confidence,executor:a.executor.confidence,risk:a.risk.confidence},stderr:r.stderr.trim()?r.stderr.trim().split('\n').slice(-1)[0]:null}))}
