import {spawn} from 'node:child_process';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {createBenchmarkFixture} from '../src/benchmark-fixture.js';import {BenchmarkSessionManager} from '../src/benchmark-session-manager.js';import {runtimeIdentity} from '../src/runtime.js';import {benchmarkAggregate,readBenchmarkRuns} from '../src/benchmark-run-store.js';
const repo=process.cwd(),fixture=path.join(os.tmpdir(),'fs-claude-bounded-repeat'),mcpPath=path.join(os.tmpdir(),'fs-v3-claude-mcp.json'),config=JSON.parse((await fs.readFile(path.join(repo,'config/local.json'),'utf8')).replace(/^\uFEFF/,'')),state=runtimeIdentity().stateRoot,manager=new BenchmarkSessionManager(state),claude=process.env.FS_CLAUDE_BIN??'C:\\Users\\sanus\\.local\\bin\\claude.exe',model=process.env.FS_CLAUDE_MODEL??'sonnet';
await fs.writeFile(mcpPath,JSON.stringify({mcpServers:{v3:{type:'http',url:`http://127.0.0.1:${config.port}/mcp/${config.endpointSecret}`}}},null,2));
const prompt=`Benchmark task. FS root name is fs and its filesystem root is C:\\Users\\sanus. The fixture cwd relative to that root is AppData/Local/Temp/fs-claude-bounded-repeat. Make exactly one change: src/math.js label() must return new-label instead of old-label. Do not change unrelated code. Use this exact efficient sequence: engineering_context(root=fs,cwd=AppData/Local/Temp/fs-claude-bounded-repeat), read_file for the target, patch_file using the returned sha256, then run_engineering_check with kind=test and command=node --test test/math.test.js. Stop immediately after the check passes. Use no other tools. Return one line only.`;
function runClaude(){return new Promise<{code:number|null;stdout:string;stderr:string;wallMs:number}>((resolve,reject)=>{const env={...process.env};delete env.ANTHROPIC_BASE_URL;const started=performance.now(),p=spawn(claude,['-p',prompt,'--mcp-config',mcpPath,'--strict-mcp-config','--allowedTools','mcp__v3__engineering_context,mcp__v3__read_file,mcp__v3__patch_file,mcp__v3__run_engineering_check','--tools','','--permission-mode','dontAsk','--permission-prompts','none','--no-session-persistence','--model',model,'--effort','low'],{cwd:fixture,env,windowsHide:true,stdio:['ignore','pipe','pipe']});let stdout='',stderr='';const timer=setTimeout(()=>{p.kill();},180000);p.stdout.on('data',x=>stdout+=x);p.stderr.on('data',x=>stderr+=x);p.on('error',reject);p.on('close',code=>{clearTimeout(timer);resolve({code,stdout:stdout.trim(),stderr:stderr.trim(),wallMs:performance.now()-started})})})}
const rows:any[]=[];for(let i=0;i<4;i++){const manifest=await createBenchmarkFixture(fixture),session=await manager.start({benchmarkId:'bounded-edit',harness:'claude-code',model,fixtureRoot:fixture,fixtureId:manifest.fixtureId,repeat:i,warmup:i===0,notes:'strict V3 four-tool bounded-edit benchmark'}),cli=await runClaude();if(cli.code!==0){const aborted=await manager.abort(session.sessionId,cli.stdout||cli.stderr||`claude exit ${cli.code}`);rows.push({repeat:i,warmup:i===0,cli,aborted});console.log(JSON.stringify(rows.at(-1),null,2));break}const finished=await manager.finish(session.sessionId,0);rows.push({repeat:i,warmup:i===0,cli,acceptance:finished.acceptance,run:finished.run,events:finished.events,largestGaps:finished.largestGaps});console.log(JSON.stringify(rows.at(-1),null,2))}
const runs=await readBenchmarkRuns(path.join(state,'performance','benchmark-runs.jsonl')),recent=runs.filter(x=>x.harness==='claude-code'&&x.benchmarkId==='bounded-edit').slice(-4),aggregate=benchmarkAggregate(recent);console.log(JSON.stringify({summary:aggregate,rows},null,2));
