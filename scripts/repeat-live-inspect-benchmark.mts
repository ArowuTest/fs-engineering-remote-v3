import {execFile} from 'node:child_process';import {promisify} from 'node:util';import path from 'node:path';const exec=promisify(execFile),self=path.resolve('scripts/mcp-benchmark-client.mts'),configs=[['v2b-current',path.resolve('../FS-Remote-MCP-V2B/config/local.json')],['v2b-optimized',path.resolve('../FS-Remote-MCP-V2B/config/local.json')],['v3-optimized',path.resolve('config/local.json')]] as const,out:any={};for(const [profile,config] of configs){const rows:any[]=[];for(let i=0;i<4;i++){const {stdout}=await exec(process.execPath,['--import','tsx',self,config,profile,'inspect-context'],{maxBuffer:1024*1024});rows.push(JSON.parse(stdout))}const measured=rows.slice(1),median=(xs:number[])=>[...xs].sort((a,b)=>a-b)[Math.floor(xs.length/2)];out[profile]={warmup:rows[0].totalWallMs,measured:measured.map(x=>({wallMs:x.totalWallMs,bytes:x.totalResponseBytes,calls:x.calls.length})),medianWallMs:median(measured.map(x=>x.totalWallMs)),medianBytes:median(measured.map(x=>x.totalResponseBytes)),medianCalls:median(measured.map(x=>x.calls.length))}}console.log(JSON.stringify(out,null,2));
