const [base,expected]=process.argv.slice(2);if(!base||!expected)throw new Error('Usage: railway-ready-check.mts <base-url> <expected-revision>');const url=base.replace(/\/$/,'')+'/readyz';let last:any;for(let i=0;i<30;i++){try{const r=await fetch(url,{signal:AbortSignal.timeout(10000)}),body=await r.json();last={status:r.status,body};if(r.status===200&&body?.ready===true&&body?.deployment?.revision===expected){console.log(JSON.stringify({ok:true,status:r.status,deployment:body.deployment}));process.exit(0)}}catch(e){last={error:e instanceof Error?e.message:String(e)}}await new Promise(r=>setTimeout(r,10000))}throw new Error(`Railway readiness/revision verification failed: ${JSON.stringify(last)}`);
