import {PersistentProcessShadowDecisionProvider} from '../src/decision-shadow-persistent.js';import {compileDecisionState} from '../src/decision-state.js';import {performance} from 'node:perf_hooks';
const python=process.env.FS_LAYA_PYTHON,model=process.env.FS_LAYA_MODEL_PATH;if(!python||!model)throw new Error('FS_LAYA_PYTHON and FS_LAYA_MODEL_PATH required');const p=new PersistentProcessShadowDecisionProvider({command:python,args:['vendor/laya-upstream/fs_shadow_worker.py'],env:{FS_LAYA_MODEL_PATH:model,FS_LAYA_DEVICE:'cpu'},providerName:'laya-warm',timeoutMs:60000});
const questions:any[]=[{id:'retry',type:'noul',proposition:'Should this engineering operation be retried without changing source?'},{id:'executor',type:'choice',options:['local','sandbox','hosted'],instructions:'Choose the safest suitable execution lane.'},{id:'risk',type:'score',levels:['low','medium','high','critical'],instructions:'Estimate operational risk.'}];
const states=[compileDecisionState({operation:'build',attempt:1,maxAttempts:3,risk:'medium',localAvailable:true,sandboxAvailable:true,hostedAvailable:true,requiredEvidence:2,freshPassingEvidence:1,freshFailingEvidence:1,failureClass:'transient'}),compileDecisionState({operation:'test',attempt:1,maxAttempts:3,risk:'high',localOnly:true,sensitive:true,localAvailable:true,sandboxAvailable:true,hostedAvailable:true,requiredEvidence:1,freshFailingEvidence:1,failureClass:'source',repositoryDirty:true,changedFileCount:3}),compileDecisionState({operation:'deploy',attempt:0,maxAttempts:1,risk:'critical',destructive:true,sensitive:true,localAvailable:true,hostedAvailable:true,requiredEvidence:2,freshPassingEvidence:2,failureClass:'none',councilAvailable:true})];
try{for(let round=0;round<3;round++)for(let i=0;i<states.length;i++){const t=performance.now(),r:any=await p.decide({schemaVersion:'fs.decision.request.v1',state:states[i],questions}),ms=Math.round(performance.now()-t),a=Object.fromEntries(r.answers.map((x:any)=>[x.id,x]));console.log(JSON.stringify({round,case:i,wallMs:ms,runtime:r.evidence.runtime,predicted:{retry:a.retry.probabilityTrue>=.5,executor:a.executor.selected,risk:a.risk.selected},confidence:{retry:a.retry.confidence,executor:a.executor.confidence,risk:a.risk.confidence}}))}}finally{p.stop()}
