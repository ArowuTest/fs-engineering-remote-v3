import os from 'node:os';import path from 'node:path';import {createBenchmarkFixture} from '../src/benchmark-fixture.js';import {validateConfig} from '../src/config.js';import {ProcessManager,type ProcessRunTelemetry} from '../src/processes.js';import {createRemoteOperations} from '../src/operations.js';
const shell=process.platform==='win32'?'powershell.exe':'/bin/sh',root=path.join(os.tmpdir(),'fs-checkpoint-micro'),rows:any[]=[];for(let i=0;i<8;i++){await createBenchmarkFixture(root);const commands:ProcessRunTelemetry[]=[];const cfg=validateConfig({endpointSecret:'e'.repeat(40),actionsSecret:'a'.repeat(40),roots:[{name:'work',path:root}]});const pm=new ProcessManager({shell,maxOutputBytes:100000,onRun:e=>commands.push(e)}),ops=createRemoteOperations(cfg,pm),read=await ops.readFile('work','src/math.js',0,80),p0=performance.now();await ops.patchFile('work','src/math.js',read.sha256,'return "old-label"','return "new-label"',false);const patchMs=performance.now()-p0,c0=performance.now(),check=await ops.runEngineeringCheck('work','.','test','node --test test/math.test.js',30000),checkWallMs=performance.now()-c0;rows.push({repeat:i,patchMs,checkWallMs,checkCommandMs:check.durationMs,status:check.status,commands:commands.map(x=>({command:x.command,durationMs:x.durationMs,spawnLatencyMs:x.spawnLatencyMs,executionMs:x.executionMs})),slowCommands:commands.filter(x=>x.durationMs>=1000).map(x=>({command:x.command,durationMs:x.durationMs,spawnLatencyMs:x.spawnLatencyMs,executionMs:x.executionMs}))})}const measured=rows.slice(1),median=(xs:number[])=>[...xs].sort((a,b)=>a-b)[Math.floor(xs.length/2)];console.log(JSON.stringify({rows,medianPatchMs:median(measured.map(x=>x.patchMs)),medianCheckWallMs:median(measured.map(x=>x.checkWallMs)),medianCheckCommandMs:median(measured.map(x=>x.checkCommandMs)),medianCheckpointOverheadMs:median(measured.map(x=>Math.max(0,x.checkWallMs-x.checkCommandMs)))},null,2));
