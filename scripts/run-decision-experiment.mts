import fs from 'node:fs/promises';import path from 'node:path';import {runGovernedLinearExperiment} from '../src/decision-experiment-runner.js';import {readExperienceOutcomes} from '../src/decision-experience-store.js';import {readNegativeExperience} from '../src/decision-negative-store.js';import {SkillCatalog,defaultSkillsRoot} from '../src/skills.js';import {buildSkillKnowledgeCorpus} from '../src/decision-skill-knowledge.js';
const state=process.env.FS_DECISION_STATE_ROOT??path.resolve('.agent-runtime','decision-learning'),examplesFile=process.env.FS_DECISION_EXAMPLES??path.join(state,'decision-examples.jsonl'),readJsonl=async(file:string)=>{try{return(await fs.readFile(file,'utf8')).split(/\r?\n/).filter(Boolean).map(x=>JSON.parse(x))}catch{return[]}},examples=await readJsonl(examplesFile),outcomes=await readExperienceOutcomes(path.join(state,'experience-outcomes.jsonl')),negative=await readNegativeExperience(path.join(state,'negative-experience.jsonl')),skills=await buildSkillKnowledgeCorpus(new SkillCatalog(defaultSkillsRoot())),questions=(process.env.FS_DECISION_QUESTIONS??'retry,evidence_sufficient,executor,risk').split(',').filter(Boolean);const result=await runGovernedLinearExperiment({root:path.join(state,'experiments'),examples,outcomes,negative,skills,questionIds:questions});console.log(JSON.stringify(result,null,2));
