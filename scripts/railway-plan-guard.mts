import fs from 'node:fs/promises';
const file=process.argv[2];if(!file)throw new Error('Usage: railway-plan-guard.mts <plan.json>');const plan=JSON.parse((await fs.readFile(file,'utf8')).replace(/^\uFEFF/,''));if(plan.ok!==true)throw new Error('Railway plan did not report ok=true.');if((plan.diagnostics??[]).length)throw new Error(`Railway plan has diagnostics: ${JSON.stringify(plan.diagnostics)}`);const changes=plan.changeSet?.changes??[],allowed=['autonomous-worker','control-plane'];for(const c of changes){if(c.kind!=='resource.update')throw new Error(`Unsafe Railway plan kind ${c.kind}: ${c.summary}`);if(!allowed.some(name=>String(c.summary).includes(name)))throw new Error(`Railway plan touches unmanaged resource: ${c.summary}`);if(/Postgres/i.test(String(c.summary)))throw new Error(`Railway plan must not modify Postgres: ${c.summary}`);}const current=plan.currentGraph?.resources??[],desired=plan.desiredGraph?.resources??[];for(const graph of [current,desired]){for(const name of ['autonomous-worker','control-plane','Postgres'])if(!graph.some((r:any)=>r.name===name))throw new Error(`Railway graph is missing ${name}.`);}console.log(JSON.stringify({ok:true,changes:changes.map((c:any)=>c.summary),destructive:false,postgresUntouched:true}));
