import fs from 'node:fs/promises';import path from 'node:path';import {runtimeIdentity} from '../src/runtime.js';import {readPerformanceEvents} from '../src/performance-store.js';import {sessionEvents} from '../src/performance-session.js';import {sessionOutsideBreakdown} from '../src/performance-gaps.js';
const state=runtimeIdentity().stateRoot,sessionsDir=path.join(state,'performance','sessions'),files=await fs.readdir(sessionsDir),sessions=[] as any[];for(const f of files){if(!f.endsWith('.json'))continue;const x=JSON.parse(await fs.readFile(path.join(sessionsDir,f),'utf8'));if(x.benchmarkId==='bounded-edit'&&x.endedAt&&(x.harness==='claude-code'||x.harness==='deterministic-client'))sessions.push(x)}sessions.sort((a,b)=>Date.parse(a.startedAt)-Date.parse(b.startedAt));const events=await readPerformanceEvents(path.join(state,'performance','mcp-events.jsonl'),{limit:50000});const rows=sessions.slice(-8).map(s=>{const xs=sessionEvents(events,s).filter(x=>x.operation!=='benchmark_session'),outside=sessionOutsideBreakdown(xs,s.startedAt,s.endedAt),handlerMs=xs.reduce((n,x)=>n+x.durationMs,0),wallMs=Math.max(0,Date.parse(s.endedAt)-Date.parse(s.startedAt));return{harness:s.harness,repeat:s.repeat,warmup:s.warmup,wallMs,handlerMs,outsideMs:Math.max(0,wallMs-handlerMs),...outside,toolCalls:xs.length}});console.log(JSON.stringify(rows,null,2));
