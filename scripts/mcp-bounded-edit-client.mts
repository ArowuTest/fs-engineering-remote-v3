const [configPath,profile='v3-optimized',fixtureRoot]=process.argv.slice(2);if(!configPath||!fixtureRoot)throw new Error('Usage: <config> <profile> <fixtureRoot>');const raw=await fs.readFile(configPath,'utf8'),config=JSON.parse(raw.replace(/^\uFEFF/,'')),url=new URL(`/mcp/${config.endpointSecret}`,`http://${config.host}:${config.port}`),client=new Client({name:'fs-bounded-edit-benchmark',version:'1'});await client.connect(new StreamableHTTPClientTransport(url));const calls:any[]=[],root='fs',cwd=path.relative('C:/Users/sanus',fixtureRoot).replaceAll('\\','/');async function call(name:string,args:any){const t=performance.now(),r:any=await client.callTool({name,arguments:args}),wallMs=performance.now()-t,bytes=Buffer.byteLength(JSON.stringify(r),'utf8');calls.push({name,wallMs,bytes});const txt=r.content?.[0]?.text??'{}';try{return JSON.parse(txt)}catch{return {text:txt}} }if(profile==='v2b-current'){await call('inspect_repository',{root,cwd});await call('repository_map',{root,cwd,limit:120});await call('applicable_instructions',{root,cwd,target:'.'})}else await call('engineering_context',{root,cwd,fileLimit:120});const read=await call('read_file',{root,path:`${cwd}/src/math.js`,offset:0,length:80}),old='return "old-label"',replacement='return "new-label"';await call('patch_file',{root,path:`${cwd}/src/math.js`,expectedSha256:read.sha256,oldText:old,newText:replacement,replaceAll:false});await call('run_engineering_check',{root,cwd,kind:'test',command:'node --test test/math.test.js',timeoutMs:30000});console.log(JSON.stringify({profile,cwd,calls,totalWallMs:calls.reduce((n,x)=>n+x.wallMs,0),totalResponseBytes:calls.reduce((n,x)=>n+x.bytes,0)},null,2));await client.close();
