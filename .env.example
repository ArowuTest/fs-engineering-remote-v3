# FS Remote V3 hosted control plane
DATABASE_URL=postgresql://user:password@host:5432/fsremote
FS_REMOTE_PUBLIC_URL=https://your-v3-host.example.com
FS_REMOTE_STATE_DIR=/app/.agent-runtime

# Optional OpenSandbox execution provider. Local customer-node execution remains default.
FS_OPENSANDBOX_URL=
FS_OPENSANDBOX_API_KEY=

# Customer node example (set on customer machine, not Railway control plane)
# FS_REMOTE_CONTROL_PLANE_URL=https://your-v3-host.example.com
# FS_REMOTE_NODE_ID=my-laptop
# FS_REMOTE_NODE_SECRET=
# FS_REMOTE_NODE_LEASE_MS=120000
